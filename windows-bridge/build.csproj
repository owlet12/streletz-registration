    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Security" />
    <Compile Include="Program.cs" />
    <Compile Include="ProtocolV3.cs" />
    <Compile Include="HttpGateway.cs" />
    <Compile Include="HttpGatewaySettings.cs" />
    <Compile Include="HttpGatewayWindows.cs" />
    <Compile Include="PanelProfiles.cs" />
    <Compile Include="RegistrationCoordinator.cs" />
    <Compile Include="RegistrationDiagnosticData.cs" />
    <Compile Include="PanelRegistrationDriver.cs" />
    <Compile Include="ProjectPanelCatalog.cs" />
