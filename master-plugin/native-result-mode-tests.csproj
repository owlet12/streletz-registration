<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeCommandResultMode.SelfTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/native-result-mode-tests/</OutputPath>
    <LangVersion>7.3</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Core"><HintPath>$(MasterInstallDir)/Core.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="Contracts.cs" />
    <Compile Include="NativeRoutePolicy.cs" />
    <Compile Include="NativeAdapterDiagnostic.cs" />
    <Compile Include="NativeCommandResultMode.cs" />
    <Compile Include="tests/NativeCommandResultModeSelfTest.cs" />
  </ItemGroup>
</Project>
