<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Plugin.StreletzRegistration</AssemblyName>
    <RootNamespace>Streletz.MasterBridge</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;obj/**/*.cs;bin/**/*.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Core"><HintPath>$(MasterInstallDir)/Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Engine"><HintPath>$(MasterInstallDir)/Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Plugin.StreletcProGUI"><HintPath>$(MasterInstallDir)/Plugin.StreletcProGUI.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RequireMasterReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MasterInstallDir)/Core.dll')" Text="Pass -p:MasterInstallDir=the inspected Master 12.4 directory (Core.dll required)." />
  </Target>
</Project>
